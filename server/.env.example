# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/utmengage

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=<generate-a-strong-random-secret>

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Email Configuration (Gmail SMTP)
# For Gmail: Enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<your-app-specific-password>
SMTP_FROM_NAME=UTM Engage
SMTP_FROM_EMAIL=noreply@utmengage.com

# Google OAuth Configuration (for Google Meet integration)
# 1. Go to https://console.cloud.google.com
# 2. Create a project and enable Google Calendar API
# 3. Configure OAuth consent screen (External, add test users)
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add redirect URI: http://localhost:5000/api/google/callback
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
